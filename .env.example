# SimLight Configuration

# --- Database (optional PostgreSQL) ---
# Leave unset to use SQLite (default, zero-config)
# DATABASE_URL=postgresql://simlight:simlight@localhost:5432/simlight

# --- Auth ---
JWT_SECRET=change-this-to-a-random-secret-in-production

# --- LLM ---
LLM_PROVIDER=auto
# Groq — https://console.groq.com (fast, recommended)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA NIM (OpenAI-compatible) — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# PLATFORM SUPERADMIN (auto-seeded on first run if missing)
# Email: admin@simlight.tech  Password: admin123

# --- Server ---
PORT=3001
APP_URL=http://localhost:5173

# --- Email (optional — logs to DB if unset) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=simlight@yourdomain.com
# SMTP_SECURE=false
